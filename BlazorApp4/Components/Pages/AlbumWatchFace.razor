@page "/albumwatchface"
@rendermode InteractiveServer

<div class="applewatch7-outline">
    <div class="applewatch7-face albumwatch-collage-bg">
        <div class="albumwatch-collage-grid">
            @for (int i = 0; i < 25; i++)
            {
                if (i < AlbumPhotos.Length)
                {
                    <img src="/@AlbumPhotos[i]" alt="Album foto" class="albumwatch-collage-img" />
                }
                else
                {
                    <div class="albumwatch-collage-placeholder"></div>
                }
            }
        </div>
    </div>
</div>
<div class="apple-watch-label">Apple Watch 7<br />45mm KAJ</div>

@code {
    private readonly string[] AlbumPhotos = new string[]
    {
        "Album/BBB.png",
        "Album/Botnia Paradise.png",
